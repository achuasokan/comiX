<%- include('../partials/header.ejs') %>
<div class="bg-black text-white flex flex-col items-center min-h-screen pb-20"> 

  <!-- Horizontal Navigation Bar -->
  <%- include('./profileSidebar.ejs') %>
  <!-- Navigation Bar end -->

  <!-- Address Info -->
  <main class="flex-1 w-full max-w-4xl px-4 md:px-8 mt-12">
    
      <div class="flex flex-col md:flex-row md:items-end justify-between border-b border-white/20 pb-4 mb-10 gap-4">
          <div>
              <h2 class="text-2xl font-bold uppercase tracking-widest text-white">Manage Addresses</h2>
              <p class="text-white/50 text-sm tracking-widest uppercase mt-2">Saved shipping locations</p>
          </div>
          <a href="/profile/add-address" class="bg-white text-black px-6 py-3 uppercase tracking-widest text-xs font-bold hover:bg-gray-200 transition-colors inline-flex items-center gap-2">
              <i class="fas fa-plus"></i> Add Address
          </a>
      </div>

      <!-- flash message  -->
      <div class="mb-8">
          <%- include('../partials/flashMessage.ejs') %>
      </div>

      <% if (addresses.length === 0) { %>
        <div class="flex flex-col items-center justify-center py-20 border border-white/10 bg-white/5 rounded-sm">
            <i class="fa-regular fa-address-card fa-3x text-white/20 mb-4"></i>
            <p class="text-white/50 text-xs tracking-widest uppercase mb-6">No Address Found in your account.</p>
        </div>
      <% } else { %>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6"> 
              <% addresses.forEach(address => { %>
                  <div class="bg-white/5 border border-white/10 p-6 flex flex-col justify-between relative <%= address.isDefault ? 'ring-1 ring-white/30' : '' %>"> 
                      <% if (address.isDefault) { %>
                          <span class="absolute top-4 right-4 text-[9px] uppercase tracking-widest border border-white/20 px-2 py-1 bg-white/10">Default</span>
                      <% } %>
                      
                      <div class="mb-6">
                          <h3 class="font-bold uppercase tracking-widest text-sm text-white mb-1"><%= address.name %></h3>
                          <p class="text-white/50 text-xs tracking-widest uppercase mb-4"><%= address.mobile %></p>
                          <p class="text-white/70 text-sm leading-relaxed">
                              <%= address.buildingName %>, <%= address.street %><br>
                              <%= address.city %>, <%= address.state %><br>
                              <%= address.country %> - <%= address.pincode %>
                          </p>
                      </div>

                      <div class="flex items-center gap-4 pt-4 border-t border-white/10">
                          <a href="/profile/edit-address/<%= address._id %>" class="text-xs uppercase tracking-widest font-bold text-white hover:text-white/70 transition-colors">Edit</a>
                          <button class="text-xs uppercase tracking-widest font-bold text-red-500 hover:text-red-400 transition-colors" onclick="deleteAddress('<%= address._id %>')">Delete</button>
                      </div>
                  </div>
              <% }) %>
          </div>
      <% } %>
  </main>
  <!-- Address Info end -->
</div>

<%- include('../partials/footer.ejs') %>
<script>
  function deleteAddress(addressId) {
    Swal.fire({
      title: "Are you sure?",
      text: "You want to delete this address",
      iconHtml: '<i class="fas fa-trash-alt text-white/50 text-3xl"></i>',
      showCancelButton: true,
      confirmButtonText: "Yes, delete it!",
      customClass: {
        popup: 'bg-[#050505] border border-white/10 text-white rounded-none shadow-2xl p-8',
        title: 'text-lg font-bold uppercase tracking-widest text-white mb-2 mt-4',
        htmlContainer: 'text-[10px] tracking-widest uppercase text-white/50 mb-6',
        confirmButton: 'bg-white text-black px-6 py-3 uppercase tracking-widest text-xs font-bold hover:bg-gray-200 transition-colors mx-2',
        cancelButton: 'bg-transparent border border-white/20 text-white px-6 py-3 uppercase tracking-widest text-xs font-bold hover:bg-white/10 transition-colors mx-2'
      },
      buttonsStyling: false
    }).then((result) => {
      if (result.isConfirmed) {
        $.ajax({
          url: `/profile/delete-address/${addressId}`,
          type: "DELETE",
          success: function (response) {
            location.reload(); // Reload the page to reflect changes
          },
          error: function (xhr) {
            Swal.fire({
              title: "Error", 
              text: "Failed to delete the address", 
              icon: "error",
              customClass: {
                popup: 'bg-[#050505] border border-white/10 text-white rounded-none shadow-2xl p-8',
                title: 'text-lg font-bold uppercase tracking-widest text-white mb-2',
                htmlContainer: 'text-[10px] tracking-widest uppercase text-white/50 mb-6',
                confirmButton: 'bg-white text-black px-6 py-3 uppercase tracking-widest text-xs font-bold hover:bg-gray-200 transition-colors',
              },
              buttonsStyling: false
            });
          }
        });
      }
    });
  }
</script>