<%- include('../partials/header.ejs') %>
<div class="bg-black text-white flex flex-col items-center min-h-screen pb-20">

  <!-- Horizontal Navigation Bar -->
  <%- include('./profileSidebar.ejs') %>
  <!-- Navigation Bar end -->

  <main class="flex-1 w-full max-w-4xl px-4 md:px-8 mt-12">
    <!-- Header Section -->
    <div class="flex flex-col md:flex-row md:items-end justify-between border-b border-white/20 pb-4 mb-10 gap-4">
        <div>
            <h2 class="text-2xl font-bold uppercase tracking-widest text-white">My Wallet</h2>
            <p class="text-white/50 text-sm tracking-widest uppercase mt-2">Manage your funds</p>
        </div>
        <!-- Minimal Icon -->
        <div class="w-10 h-10 rounded-full border border-white/20 flex items-center justify-center text-white text-sm bg-white/5 shrink-0 hidden md:flex">
            <i class="fas fa-wallet"></i>
        </div>
    </div>

    <!-- Wallet Balance & Actions -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10">
      <!-- Balance Card -->
      <div class="border border-white/10 bg-white/5 p-6 flex flex-col justify-center min-h-[140px]">
        <h3 class="text-xs font-bold uppercase tracking-widest text-white/50 mb-2">Current Balance</h3>
        <% if (wallet && wallet.balance > 0) { %>
          <p class="text-4xl font-light text-white">₹<%= wallet.balance.toFixed(2) %></p>
        <% } else { %>
          <p class="text-4xl font-light text-white">₹0.00</p>
        <% } %>
      </div>

      <!-- Add Money Card -->
      <div class="border border-white/10 bg-white/5 p-6 flex flex-col justify-center min-h-[140px]">
        <div id="addMoneyContainer" class="w-full flex justify-center">
          <button id="addMoneyBtn" class="w-full sm:w-auto border border-white text-white px-8 py-3 uppercase tracking-widest text-xs font-bold hover:bg-white hover:text-black transition-colors">
            Add Money
          </button>
        </div>
        
        <div id="addMoneyInput" class="hidden w-full flex-col sm:flex-row gap-4">
          <input type="number" id="amount" placeholder="Enter Amount" class="flex-1 bg-transparent border-b border-white/20 text-white text-sm p-2 focus:outline-none focus:border-white transition-colors" />
          <button id="confirmAdd" class="bg-white text-black px-6 py-2 uppercase tracking-widest text-xs font-bold hover:bg-gray-200 transition-colors whitespace-nowrap">
            Confirm
          </button>
        </div>
      </div>
    </div>

    <!-- Transaction History Section -->
    <h3 class="text-xs font-bold uppercase tracking-widest text-white/50 mb-4">Transaction History</h3>
    <div class="border border-white/10 bg-white/5 overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm whitespace-nowrap">
          <thead class="border-b border-white/10 bg-white/5 text-[10px] uppercase tracking-widest text-white/50">
            <tr>
              <th class="py-4 px-6 font-bold">Date</th>
              <th class="py-4 px-6 font-bold">Type</th>
              <th class="py-4 px-6 font-bold text-right">Amount</th>
              <th class="py-4 px-6 font-bold">Order ID</th>
            </tr>
          </thead>
          <tbody class="text-white/80">
            <% if (wallet && wallet.transaction && wallet.transaction.length > 0) { %>
              <% wallet.transaction.forEach(transaction => { %>
                <tr class="border-b border-white/5 hover:bg-white/5 transition-colors">
                  <td class="py-4 px-6"><%= new Date(transaction.transactionDate).toLocaleDateString() %></td>
                  <td class="py-4 px-6">
                    <span class="px-2 py-1 text-[9px] uppercase tracking-widest border <%= transaction.transactionType.toLowerCase().includes('credit') ? 'border-green-500/30 text-green-400' : 'border-red-500/30 text-red-400' %>">
                      <%= transaction.transactionType %>
                    </span>
                  </td>
                  <td class="py-4 px-6 text-right font-bold <%= transaction.transactionType.toLowerCase().includes('credit') ? 'text-green-400' : 'text-red-400' %>">
                    <%= transaction.transactionType.toLowerCase().includes('credit') ? '+' : '-' %>₹<%= transaction.walletAmount.toFixed(2) %>
                  </td>
                  <td class="py-4 px-6 text-white/50 font-mono text-xs"><%= transaction.order_id || 'N/A' %></td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="4" class="text-center py-8 text-white/50 text-xs uppercase tracking-widest">No transactions found.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>

<script>
  document.getElementById('addMoneyBtn').addEventListener('click', function() {
    document.getElementById('addMoneyContainer').classList.add('hidden');
    document.getElementById('addMoneyInput').classList.remove('hidden');
    document.getElementById('addMoneyInput').classList.add('flex');
  });

  document.getElementById('confirmAdd').addEventListener('click', function() {
    const amount = document.getElementById('amount').value;
    if (amount) {
      // Add your logic to handle adding money here
      alert(`You are adding ₹${amount} to your wallet.`);
      // Reset the input field
      document.getElementById('amount').value = '';
      document.getElementById('addMoneyInput').classList.add('hidden');
      document.getElementById('addMoneyInput').classList.remove('flex');
      document.getElementById('addMoneyContainer').classList.remove('hidden');
    } else {
      alert('Please enter a valid amount.');
    }
  });
</script>

<%- include('../partials/footer.ejs') %>