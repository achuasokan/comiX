<!-- views/user/orderDetail.ejs -->
<div class="bg-black text-white flex flex-col items-center min-h-screen pb-20">
   <%- include('../partials/header') %>
   <!-- Horizontal Navigation Bar -->
   <%- include('./profileSidebar.ejs') %>
   <!-- Navigation Bar end -->

   <main class="flex-1 w-full max-w-4xl px-4 md:px-8 mt-12">
    <!-- Header Section -->
    <div class="flex flex-col md:flex-row md:items-end justify-between border-b border-white/20 pb-4 mb-10 gap-4">
        <div>
            <h2 class="text-2xl font-bold uppercase tracking-widest text-white">Order Details</h2>
            <p class="text-white/50 text-sm tracking-widest uppercase mt-2">
                Order #<%= order._id.toString().slice(-8).toUpperCase() %>
            </p>
        </div>
        <div class="w-10 h-10 rounded-full border border-white/20 flex items-center justify-center text-white text-sm bg-white/5 shrink-0 hidden md:flex">
            <i class="fas fa-receipt"></i>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10">
        <!-- Order Info -->
        <div class="border border-white/10 bg-white/5 p-6 relative">
            <h3 class="text-xs font-bold uppercase tracking-widest text-white/50 mb-4 border-b border-white/10 pb-2">Information</h3>
            <div class="space-y-2 text-sm">
                <p class="flex justify-between"><span class="text-white/50">Date:</span> <span><%= order.createdAt.toLocaleDateString() %></span></p>
                <p class="flex justify-between"><span class="text-white/50">Payment:</span> <span><%= order.paymentMethod %></span></p>
                <p class="flex justify-between"><span class="text-white/50">Status:</span> <span><%= order.paymentStatus %></span></p>
            </div>
        </div>

        <!-- Shipping Address -->
        <div class="border border-white/10 bg-white/5 p-6 relative">
            <h3 class="text-xs font-bold uppercase tracking-widest text-white/50 mb-4 border-b border-white/10 pb-2">Shipping Address</h3>
            <% if (order.address) { %>
                <div class="space-y-1 text-sm text-white/80">
                    <p class="font-bold text-white"><%= order.address.name %></p>
                    <p><%= order.address.buildingName %>, <%= order.address.street %></p>
                    <p><%= order.address.city %>, <%= order.address.state %>, <%= order.address.country %></p>
                    <p><%= order.address.pincode %></p>
                    <p class="text-white/50 mt-2">Mobile: <span class="text-white/80"><%= order.address.mobile %></span></p>
                </div>
            <% } else { %>
                <p class="text-sm text-white/50">No shipping address available.</p>
            <% } %>
        </div>
    </div>

    <!-- Ordered Items -->
    <h3 class="text-xs font-bold uppercase tracking-widest text-white/50 mb-4">Items (<%= order.items.length %>)</h3>
    <div class="space-y-4 mb-10">
      <% order.items.forEach(item => { %>
        <div class="border border-white/10 bg-white/5 p-4 flex flex-col sm:flex-row gap-4 items-start sm:items-center">
            
            <% if (item.product) { %>
                <img src="<%= item.product.image[1] %>" alt="<%= item.product.name %>" class="w-20 h-28 object-cover shrink-0 border border-white/10">
                <div class="flex-1">
                    <h4 class="text-sm font-bold uppercase tracking-wide text-white"><%= item.product.name %></h4>
                    <p class="text-xs text-white/50 uppercase tracking-widest mt-1"><%= item.product.category.name %></p>
                    <div class="mt-4 flex gap-4 text-sm">
                        <p class="text-white/50">Qty: <span class="text-white"><%= item.quantity %></span></p>
                        <p class="text-white/50">Price: <span class="text-white">₹<%= item.discountPrice %></span></p>
                    </div>
                </div>
            <% } else { %>
                <div class="w-20 h-28 bg-white/5 flex items-center justify-center shrink-0 border border-white/10">
                    <i class="fas fa-image text-white/20"></i>
                </div>
                <div class="flex-1">
                    <p class="text-sm text-white/50 uppercase tracking-widest">Product not found</p>
                </div>
            <% } %>

            <div class="flex flex-col gap-3 sm:items-end w-full sm:w-auto border-t sm:border-t-0 border-white/10 pt-4 sm:pt-0">
                <div class="text-right">
                    <p class="text-xs text-white/50 uppercase tracking-widest mb-1">Item Total</p>
                    <p class="text-xl font-light text-white">₹<%= item.itemTotal %></p>
                </div>
                
                <span class="inline-flex items-center px-3 py-1 text-[10px] uppercase tracking-widest font-bold border
                    <%= item.itemStatus === 'Cancelled' || item.itemStatus === 'Returned' ? 'border-red-500/50 text-red-400' 
                    : item.itemStatus === 'Delivered' ? 'border-green-500/50 text-green-400' 
                    : 'border-white/20 text-white' %>">
                    <%= item.itemStatus %>
                </span>

                <!-- Action Buttons -->
                <% if (item.itemStatus === 'Delivered') { %>
                    <button class="return-order-btn border border-white text-white px-4 py-2 uppercase tracking-widest text-[10px] font-bold hover:bg-white hover:text-black transition-colors w-full sm:w-auto mt-2" data-order-id="<%= order._id %>" data-item-id="<%= item._id %>">Return</button>
                <% } else if (item.itemStatus !== 'Cancelled' && item.itemStatus !== 'Delivered' && item.itemStatus !== 'Returned' && item.itemStatus !== 'Return Requested' ) { %>
                    <% if (item.product) { %>
                    <button class="cancel-order-btn border border-red-500 text-red-500 px-4 py-2 uppercase tracking-widest text-[10px] font-bold hover:bg-red-500 hover:text-white transition-colors w-full sm:w-auto mt-2" data-order-id="<%= order._id %>" data-item-id="<%= item._id %>" data-product-id="<%= item.product._id %>">Cancel</button>
                    <% } %>
                <% } %>
            </div>
        </div>
      <% }) %>
    </div>

    <!-- Order Summary -->
    <div class="border border-white/10 bg-white/5 p-6 mb-10 sm:w-1/2 ml-auto">
        <h3 class="text-xs font-bold uppercase tracking-widest text-white/50 mb-4 border-b border-white/10 pb-2">Order Summary</h3>
        <div class="space-y-2 text-sm text-white/80">
            <div class="flex justify-between">
                <p>Subtotal</p>
                <p>₹<%= order.subtotal %></p>
            </div>
            <div class="flex justify-between">
                <p>Discount</p>
                <p class="text-white">-₹<%= order.discount || 0 %></p>
            </div>
            <div class="flex justify-between">
                <p>Delivery Charges</p>
                <p>₹0</p>
            </div>
            <div class="border-t border-white/10 my-2 pt-2 flex justify-between font-bold text-lg text-white">
                <p>Total</p>
                <p>₹<%= order.total %></p>
            </div>
        </div>
    </div>
  </main>

  <%- include('../partials/footer') %>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const cancelButtons = document.querySelectorAll('.cancel-order-btn');

    cancelButtons.forEach(button => {
      button.addEventListener('click', function(e) {
        e.preventDefault();
        const orderId = this.getAttribute('data-order-id');
        const itemId = this.getAttribute('data-item-id');
        const productId = this.getAttribute('data-product-id');

        Swal.fire({
          title: 'Are you sure?',
          text: "You want to cancel this item ",
          icon: 'warning',
          showCancelButton: true,
          confirmButtonColor: '#3085d6',
          cancelButtonColor: '#d33',
          confirmButtonText: 'Yes, cancel it!',
          customClass: {
            popup: 'bg-black border-2 border-gray-800 text-white rounded-lg shadow-lg p-6',
            title: 'text-xl font-bold',
            content: 'text-base mb-4',
            confirmButton: 'bg-green-600 text-white rounded-lg px-4 py-2 hover:bg-green-700 transition duration-200 ease-in-out',
            cancelButton: 'bg-red-600 text-white rounded-lg px-4 py-2 hover:bg-red-700 transition duration-200 ease-in-out'
          }
        }).then((result) => {
          if (result.isConfirmed) {
            cancelOrder(orderId, itemId,productId);
          }
        });
      });
    });

    function cancelOrder(orderId, itemId,productId) {
      fetch(`/order/${orderId}/item/${itemId}/product/${productId}/cancel`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
      })
      .then(response => {
        if (!response.ok) {
          throw new Error('Network response was not ok');
        }
        return response.json();
      })
      .then(data => {
        Swal.fire({
          title: 'Cancelled!',
          text: 'Your order has been cancelled.',
          icon: 'success',
          customClass: {
            popup: 'bg-black border-2 border-gray-800 text-white rounded-lg shadow-lg p-6',
            title: 'text-2xl font-bold', 
            content: 'text-lg',
            confirmButton: 'bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700', 
          },
          buttonsStyling: false, 
        }).then(() => {
          window.location.reload();
        });
      })
      .catch(error => {
        console.error('Error:', error);
        Swal.fire(
          'Error!',
          'There was a problem cancelling your order.',
          'error'
        );
      });
    }
  const returnButtons = document.querySelectorAll('.return-order-btn');

    returnButtons.forEach(button => {
      button.addEventListener('click', function(e) {
        e.preventDefault();
        const orderId = this.getAttribute('data-order-id');
        const itemId = this.getAttribute('data-item-id');

        Swal.fire({
          title: 'Return Reason',
          input: 'textarea',
          inputPlaceholder: 'Please enter your reason for returning the item...',
          showCancelButton: true,
          confirmButtonText: 'Submit',
          cancelButtonText: 'Cancel',
          customClass: {
            popup: 'bg-black border-2 border-gray-800 text-white rounded-lg shadow-lg p-6',
            title: 'text-xl font-bold',
            input: 'text-base mb-4',
            confirmButton: 'bg-green-600 text-white rounded-lg px-4 py-2 hover:bg-green-700 transition duration-200 ease-in-out',
            cancelButton: 'bg-red-600 text-white rounded-lg px-4 py-2 hover:bg-red-700 transition duration-200 ease-in-out'
          }
        }).then((result) => {
          if (result.isConfirmed) {
            const returnReason = result.value;
            submitReturnRequest(orderId, itemId, returnReason);
          }
        });
      });
    });

    function submitReturnRequest(orderId, itemId, returnReason) {
      fetch(`/order/${orderId}/item/${itemId}/return`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ returnReason }),
      })
      .then(response => {
        if (!response.ok) {
          throw new Error('Network response was not ok');
        }
        return response.json();
      })
      .then(data => {
        Swal.fire({
          title: 'Success!',
          text: 'Your return request has been submitted.',
          icon: 'success',
          customClass: {
            popup: 'bg-black border-2 border-gray-800 text-white rounded-lg shadow-lg p-6',
            title: 'text-2xl font-bold',
            confirmButton: 'bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700',
          }
        }).then(() => {
          window.location.reload();
        });
      })
      .catch(error => {
        console.error('Error:', error);
        Swal.fire(
          'Error!',
          'There was a problem submitting your return request.',
          'error'
        );
      });
    }
  })
  
</script>