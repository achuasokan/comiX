<div class="bg-black text-white min-h-screen flex flex-col">
  <%- include('../partials/header.ejs')  %>
  <h1 class="text-3xl font-bold text-center my-6">Your Wishlist</h1>

  <div class="flex-grow">
    <% if (wishlist.productsId.length > 0) { %>
      <div class="max-w-6xl mx-auto px-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8 px-6 lg:px-12 mt-10 mb-16 max-w-7xl mx-auto">
          <% wishlist.productsId.forEach(product => { %>
            <article id="product-<%= product._id %>" class="group relative rounded-2xl overflow-hidden shadow-2xl aspect-[3/4] cursor-pointer transform hover:-translate-y-2 transition-transform duration-500">
              <a href="/product/<%= product._id %>" class="block w-full h-full">
                <img src="<%= product.image[1] || product.image[0] %>" alt="<%= product.name %>" class="w-full h-full object-cover transform scale-100 group-hover:scale-110 transition-transform duration-700 ease-in-out" />
                
                <!-- Discount Badge -->
                <% if(product.discountedPrice < product.price) { %>
                  <div class="absolute top-4 left-4 bg-gradient-to-r from-red-600 to-orange-500 text-white text-xs font-bold px-3 py-1.5 rounded-full shadow-lg z-10">
                    <%= Math.round(((product.price - product.discountedPrice) / product.price) * 100) %>% OFF
                  </div>
                <% } %>

                <!-- Dark Overlay for text readability -->
                <div class="absolute inset-0 bg-gradient-to-t from-[#050505] via-black/60 to-transparent opacity-90 transition-opacity duration-300"></div>
                
                <!-- Content overlay at bottom -->
                <div class="absolute inset-0 flex flex-col justify-end p-6 z-10">
                  <span class="text-orange-500 text-xs font-bold uppercase tracking-wider mb-1 drop-shadow-md"><%= product.category.name %></span>
                  <h3 class="text-xl font-bold text-white mb-2 line-clamp-2 almendra-sc-regular drop-shadow-md"><%= product.name %></h3>
                  
                  <div class="flex items-center justify-between mt-2 transform translate-y-2 group-hover:translate-y-0 transition-transform duration-300">
                    <div class="flex flex-col">
                      <% if(product.discountedPrice < product.price) { %>
                        <span class="text-2xl text-white font-bold drop-shadow-md">₹<%= product.discountedPrice.toFixed(0) %></span>
                        <span class="text-sm text-gray-300 line-through drop-shadow-md">₹<%= product.price %></span>
                      <% } else { %>
                        <span class="text-2xl text-white font-bold drop-shadow-md">₹<%= product.price %></span>
                      <% } %>
                    </div>
                  </div>
                </div>
              </a>

              <!-- Quick Actions Overlay -->
              <div class="absolute top-4 right-4 flex flex-col gap-3 opacity-100 md:opacity-0 group-hover:opacity-100 transform translate-x-0 md:translate-x-4 group-hover:translate-x-0 transition-all duration-300 z-20">
                <button type="button" onclick="openModal('<%= product._id %>')" class="w-10 h-10 rounded-full bg-black/40 backdrop-blur-md hover:bg-red-600 text-white flex items-center justify-center transition-all shadow-lg border border-white/20" title="Remove from Wishlist">
                  <i class="fas fa-trash"></i>
                </button>
                <button onclick="addToCart('<%= product._id %>')" class="w-10 h-10 rounded-full bg-black/40 backdrop-blur-md hover:bg-orange-500 text-white flex items-center justify-center transition-all shadow-lg border border-white/20" title="Add to Cart">
                  <i class="fas fa-cart-plus"></i>
                </button>
              </div>
            </article>
          <% }) %>
        </div>

        <!-- Pagination -->
        <% if (totalPages > 1) { %>
        <div class="flex justify-center items-center gap-2 mt-12 mb-8">
          <% for(let i=1; i<=totalPages; i++){ %>
            <a href="?page=<%= i %>"
              class="w-10 h-10 flex items-center justify-center text-xs font-bold transition-all <%= currentPage === i ? 'bg-white text-black' : 'text-white/50 border border-white/10 hover:bg-white/10 hover:text-white' %> rounded-sm">
              <%= i %>
            </a>
          <% } %>
        </div>
        <% } %>

      </div>
    <% } else { %>
      <div class="flex flex-col items-center justify-center py-24 border border-white/10 bg-white/5 mt-10 max-w-7xl mx-auto px-4 w-full">
        <div class="w-20 h-20 rounded-full border border-white/20 flex items-center justify-center text-white/20 text-3xl bg-white/5 mb-6">
            <i class="fas fa-heart"></i>
        </div>
        <h2 class="text-xl font-bold uppercase tracking-widest mb-2 text-white">Empty Wishlist</h2>
        <p class="text-white/50 text-xs tracking-widest uppercase mb-8 text-center">You have no items in your wishlist.</p>
        <a href="/shop/allProducts" class="border border-white text-white px-8 py-3 uppercase tracking-widest text-[10px] font-bold hover:bg-white hover:text-black transition-colors">
          Shop Now
        </a>
      </div>
    <% } %>
  </div>

  <%- include('../partials/footer.ejs')  %>
</div>

<!-- Modal Structure -->
<div id="deleteModal" class="fixed inset-0 z-[100] flex items-center justify-center hidden bg-black/80 backdrop-blur-sm">
  <div class="bg-[#050505] border border-white/10 p-8 w-11/12 max-w-md relative shadow-2xl">
    <button class="absolute top-4 right-4 text-white/50 hover:text-white transition-colors" onclick="closeModal()">
      <i class="fas fa-times"></i>
    </button>
    
    <div class="text-center mb-8 mt-4">
      <i class="fas fa-trash-alt text-white/30 text-4xl mb-6"></i>
      <h2 class="text-lg font-bold uppercase tracking-widest text-white mb-2">Are you sure?</h2>
      <p class="text-[10px] tracking-widest uppercase text-white/50">You want to remove this product from your wishlist</p>
    </div>
    
    <div class="flex flex-col sm:flex-row justify-center gap-4">
      <button class="bg-transparent border border-white/20 text-white px-6 py-3 uppercase tracking-widest text-xs font-bold hover:bg-white/10 transition-colors w-full" onclick="closeModal()">Cancel</button>
      <button id="confirmDelete" class="bg-white text-black px-6 py-3 uppercase tracking-widest text-xs font-bold hover:bg-gray-200 transition-colors w-full">Remove</button>
    </div>
  </div>
</div>

<script>
  let productIdToDelete;

  function openModal(productId) {
    productIdToDelete = productId; // Store the product ID to delete
    document.getElementById('deleteModal').classList.remove('hidden');
  }

  function closeModal() {
    document.getElementById('deleteModal').classList.add('hidden');
  }

  document.getElementById('confirmDelete').onclick = function() {
  fetch(`/wishlist/${productIdToDelete}/delete`, {
    method: 'DELETE'
  })
.then(response => response.json())
.then(data => {
  if (data.message) {
    document.getElementById(`product-${productIdToDelete}`).remove();
    closeModal();
    showToast(data.message, 'green');
  //  location.reload()
  } else {
    throw new Error('Failed to remove product from wishlist');
  }
})
.catch(error => {
  console.error('Error removing product from wishlist:', error);
  showToast('An error occurred while removing the product');
})
  };

  function showToast(message, color) {
    Toastify({
      text: message,
      duration: 3000,
      gravity: 'bottom',
      position: 'center',
      backgroundColor: color,
    }).showToast();
  }
</script>