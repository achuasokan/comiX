<div class="bg-black text-white min-h-screen flex flex-col"> 
  <%- include('../partials/header.ejs') %>
  
  <div class="flex-grow flex items-center justify-center p-4">
    <div class="text-center max-w-lg mx-auto bg-white/5 border border-white/10 p-12 relative overflow-hidden">
      <!-- subtle red glow in background -->
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-64 h-64 bg-red-600/10 blur-[80px] rounded-full pointer-events-none"></div>
      
      <div class="relative z-10">
        <div class="w-20 h-20 mx-auto rounded-full border border-red-500/30 flex items-center justify-center text-red-500 text-3xl bg-red-500/10 mb-8">
            <i class="fas fa-times"></i>
        </div>
        
        <h1 class="text-3xl font-bold uppercase tracking-widest text-white mb-4">Order Failed</h1>
        <p class="text-sm tracking-widest uppercase text-white/50 mb-10 leading-relaxed">Unfortunately, your order could not be processed. Please try again or check your payment status.</p>
        
        <div class="flex flex-col sm:flex-row justify-center space-y-4 sm:space-y-0 sm:space-x-4">
          <a href="/profile/orders" class="bg-transparent border border-white/20 text-white py-4 px-8 text-xs uppercase tracking-widest font-bold hover:bg-white/10 transition-colors">Order History</a>
          <a href="/" class="bg-white text-black border border-white py-4 px-8 text-xs uppercase tracking-widest font-bold hover:bg-gray-200 transition-colors">Go to Home</a>
        </div>
      </div>
    </div>
  </div>

  <%- include('../partials/footer.ejs') %>
</div>