<%- include ('../partials/header.ejs') %>

<div class="min-h-screen bg-black flex text-white relative">
  <!-- Left Side: Brand/Graphic -->
  <div class="hidden lg:flex lg:w-1/2 relative overflow-hidden bg-[#050505] border-r border-white/10 items-center justify-center p-12">
    <div class="absolute inset-0 z-0">
      <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-red-600/20 blur-[120px] rounded-full mix-blend-screen"></div>
      <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-yellow-500/10 blur-[120px] rounded-full mix-blend-screen"></div>
      <div class="absolute inset-0" style="background-image: radial-gradient(circle at 2px 2px, rgba(255,255,255,0.15) 1px, transparent 0); background-size: 32px 32px;"></div>
    </div>
    
    <div class="relative z-10 max-w-lg">
      <h1 class="text-6xl font-bold uppercase tracking-tighter mb-6 leading-tight">Recover<br>Your<br>Access.</h1>
      <p class="text-white/50 text-sm tracking-widest uppercase leading-loose border-l-2 border-orange-500 pl-6">
        Don't worry, it happens to the best of us. Enter your email to receive a password reset code.
      </p>
    </div>
  </div>

  <!-- Right Side: Form -->
  <div class="w-full lg:w-1/2 flex items-center justify-center p-8 sm:p-12 md:p-16 relative">
    <div class="w-full max-w-md relative z-10">
      
      <div class="mb-10 text-center lg:text-left">
        <h2 class="text-3xl font-bold uppercase tracking-widest mb-2">Forgot Password</h2>
        <p class="text-[10px] tracking-widest uppercase text-white/50">Enter the email associated with your account.</p>
      </div>
      
      <%- include('../partials/flashMessage.ejs') %>

      <form class="space-y-6" action="/password/forgot" method="POST" id="forgotPasswordForm">
       
        <div class="group">
          <label for="email" class="block mb-2 text-[10px] uppercase tracking-widest font-bold text-white/50 group-focus-within:text-white transition-colors">Email Address</label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 flex items-center pl-4 pointer-events-none">
              <i class="fas fa-envelope text-white/30 group-focus-within:text-white transition-colors"></i>
            </div>
            <input id="email" name="email" type="email" class="w-full bg-white/5 border border-white/10 text-white text-sm py-3.5 pl-12 pr-4 focus:outline-none focus:border-white focus:bg-white/10 transition-all rounded-sm placeholder-white/20 tracking-widest" placeholder="name@example.com" required>
          </div>
        </div>

        <div class="pt-2">
          <button type="submit" class="w-full bg-white text-black py-4 uppercase tracking-widest text-xs font-bold hover:bg-gray-200 transition-colors shadow-[0_0_20px_rgba(255,255,255,0.1)] hover:shadow-[0_0_30px_rgba(255,255,255,0.2)]">Send Reset Code</button>
        </div>
      </form>

      <div class="mt-8 text-center lg:text-left">
        <p class="text-[10px] uppercase tracking-widest text-white/50">
          Remember your password? 
          <a href="/login" class="font-bold text-white hover:text-gray-300 transition-colors border-b border-white pb-0.5 ml-2 cursor-pointer focus:outline-none">Sign In</a>
        </p>
      </div>

    </div>
  </div>
</div>

<%- include ('../partials/footer.ejs') %>