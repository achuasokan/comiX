<%- include ('../partials/header.ejs') %>

<div class="min-h-screen bg-black flex text-white relative">
  <!-- Left Side: Brand/Graphic -->
  <div class="hidden lg:flex lg:w-1/2 relative overflow-hidden bg-[#050505] border-r border-white/10 items-center justify-center p-12">
    <div class="absolute inset-0 z-0">
      <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-red-600/20 blur-[120px] rounded-full mix-blend-screen"></div>
      <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-yellow-500/10 blur-[120px] rounded-full mix-blend-screen"></div>
      <div class="absolute inset-0" style="background-image: radial-gradient(circle at 2px 2px, rgba(255,255,255,0.15) 1px, transparent 0); background-size: 32px 32px;"></div>
    </div>
    
    <div class="relative z-10 max-w-lg">
      <h1 class="text-6xl font-bold uppercase tracking-tighter mb-6 leading-tight">Create<br>New<br>Password.</h1>
      <p class="text-white/50 text-sm tracking-widest uppercase leading-loose border-l-2 border-orange-500 pl-6">
        Make it strong, make it memorable. Set your new password to regain access to your ComiX account.
      </p>
    </div>
  </div>

  <!-- Right Side: Form -->
  <div class="w-full lg:w-1/2 flex items-center justify-center p-8 sm:p-12 md:p-16 relative">
    <div class="w-full max-w-md relative z-10">
      
      <div class="mb-10 text-center lg:text-left">
        <h2 class="text-3xl font-bold uppercase tracking-widest mb-2">Reset Password</h2>
        <p class="text-[10px] tracking-widest uppercase text-white/50">Enter and confirm your new password.</p>
      </div>
      
      <%- include('../partials/flashMessage.ejs') %>

      <form class="space-y-6" action="/password/reset" method="POST" id="resetPasswordForm">
        
        <div class="group">
          <label for="newPassword" class="block mb-2 text-[10px] uppercase tracking-widest font-bold text-white/50 group-focus-within:text-white transition-colors">New Password</label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 flex items-center pl-4 pointer-events-none">
              <i class="fas fa-lock text-white/30 group-focus-within:text-white transition-colors"></i>
            </div>
            <input id="newPassword" name="newPassword" type="password" class="w-full bg-white/5 border border-white/10 text-white text-sm py-3.5 pl-12 pr-12 focus:outline-none focus:border-white focus:bg-white/10 transition-all rounded-sm placeholder-white/20 tracking-widest" placeholder="Enter new password" required>
            <button type="button" id="toggleResetPassword" class="absolute inset-y-0 right-0 flex items-center pr-4 text-white/30 hover:text-white transition-colors">
              <i class="fas fa-eye" id="resetEyeIcon"></i>
            </button>
          </div>
          <p id="passwordError" class="text-red-400 text-[10px] mt-2" aria-live="assertive"></p>
        </div>

        <div class="group">
          <label for="confirmPassword" class="block mb-2 text-[10px] uppercase tracking-widest font-bold text-white/50 group-focus-within:text-white transition-colors">Confirm Password</label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 flex items-center pl-4 pointer-events-none">
              <i class="fas fa-lock text-white/30 group-focus-within:text-white transition-colors"></i>
            </div>
            <input id="confirmPassword" name="confirmPassword" type="password" class="w-full bg-white/5 border border-white/10 text-white text-sm py-3.5 pl-12 pr-12 focus:outline-none focus:border-white focus:bg-white/10 transition-all rounded-sm placeholder-white/20 tracking-widest" placeholder="Confirm new password" required>
            <button type="button" id="toggleConfirmResetPassword" class="absolute inset-y-0 right-0 flex items-center pr-4 text-white/30 hover:text-white transition-colors">
              <i class="fas fa-eye" id="confirmResetEyeIcon"></i>
            </button>
          </div>
          <p id="confirmPasswordError" class="text-red-400 text-[10px] mt-2" aria-live="assertive"></p>
        </div>

        <div class="pt-2">
          <button type="submit" class="w-full bg-white text-black py-4 uppercase tracking-widest text-xs font-bold hover:bg-gray-200 transition-colors shadow-[0_0_20px_rgba(255,255,255,0.1)] hover:shadow-[0_0_30px_rgba(255,255,255,0.2)]">Update Password</button>
        </div>

      </form>

    </div>
  </div>
</div>

<%- include ('../partials/footer.ejs') %>

<script>
  const form = document.getElementById('resetPasswordForm');
  const passwordInput = document.getElementById('newPassword');
  const confirmPasswordInput = document.getElementById('confirmPassword');
  const confirmPasswordError = document.getElementById('confirmPasswordError');

  confirmPasswordInput.addEventListener('input',function(){
    if(passwordInput.value !== confirmPasswordInput.value){
      confirmPasswordError.textContent = "The passwords you entered do not match. Please try again."
    } else {
      confirmPasswordError.textContent = "";
    }
  })

  form.addEventListener('submit',function(event) {
    let valid = true;
    if (passwordInput.value !== confirmPasswordInput.value) {
      confirmPasswordError.textContent = "The passwords you entered do not match. Please try again."
      valid = false;
    }

    if(!valid){
      event.preventDefault()
    }
  })

  // toggle reset password visibility
  const toggleResetPasswords = document.getElementById('toggleResetPassword');
  const resetPasswordInputs = document.getElementById('newPassword');
  const resetEyeIcon = document.getElementById('resetEyeIcon');

  toggleResetPasswords.addEventListener('click', function () {
    const type = resetPasswordInputs.getAttribute('type') === 'password' ? 'text' : 'password';
    resetPasswordInputs.setAttribute('type', type);
    
    if (type === 'password') {
        resetEyeIcon.classList.remove('fa-eye-slash');
        resetEyeIcon.classList.add('fa-eye');
    } else {
        resetEyeIcon.classList.remove('fa-eye');
        resetEyeIcon.classList.add('fa-eye-slash');
    }
  });

  // toggle confirm reset password visibility
  const toggleConfirmResetPasswords = document.getElementById('toggleConfirmResetPassword');
  const confirmResetPasswordInputs = document.getElementById('confirmPassword');
  const confirmResetEyeIcon = document.getElementById('confirmResetEyeIcon');

  toggleConfirmResetPasswords.addEventListener('click', function () {
    const type = confirmResetPasswordInputs.getAttribute('type') === 'password' ? 'text' : 'password';
    confirmResetPasswordInputs.setAttribute('type', type);
    
    if (type === 'password') {
        confirmResetEyeIcon.classList.remove('fa-eye-slash');
        confirmResetEyeIcon.classList.add('fa-eye');
    } else {
        confirmResetEyeIcon.classList.remove('fa-eye');
        confirmResetEyeIcon.classList.add('fa-eye-slash');
    }
  });
</script>
