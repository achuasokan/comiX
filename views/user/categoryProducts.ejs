<!-- Main container/body -->
<div class="bg-[#050505] min-h-screen text-white pb-12">

  <%- include ('../partials/header.ejs')%>

    <!-- Hero Banner -->
    <div class="relative flex justify-center items-center h-40 sm:h-56 md:h-64 overflow-hidden border-b border-white/10">
        <!-- Background Image -->
        <div class="absolute inset-0 bg-cover bg-center" style="background-image: url('<%= category.image %>');"></div>
        <!-- Dark Overlay -->
        <div class="absolute inset-0 bg-black/70"></div>
        
        <div class="relative z-10 text-center px-4">
            <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-white uppercase tracking-widest drop-shadow-lg"><%= category.name %></h1>
            <p class="text-white/50 text-[10px] uppercase tracking-widest mt-4">Explore our <%= category.name %> collection</p>
        </div>
    </div>

    <!-- Main Content Area -->
    <div class="max-w-7xl mx-auto px-6 lg:px-12 py-8">
        
        <!-- Filter and Sort Controls -->
        <div class="flex flex-col sm:flex-row justify-end items-center mb-8 gap-4">
            <!-- Sorting option -->
            <div class="flex items-center w-full sm:w-auto">
                <label for="sort" class="text-[10px] uppercase tracking-widest text-white/50 mr-3 hidden sm:block">Sort:</label>
                <div class="relative w-full sm:w-64">
                    <select id="sort" class="w-full appearance-none bg-white/5 border border-white/10 text-white text-[10px] uppercase tracking-widest py-3 pl-4 pr-10 rounded-sm focus:outline-none focus:border-white focus:bg-white/10 transition-all cursor-pointer" onchange="sortProducts()">
                        <option class="bg-black text-white" value="latest" <%=sortOption==='latest' ? 'selected' : "" %>>Latest Arrivals</option>
                        <option class="bg-black text-white" value="asc" <%=sortOption==='asc' ? 'selected' : "" %>>Price: Low to High</option>
                        <option class="bg-black text-white" value="desc" <%=sortOption==='desc' ? 'selected' : "" %>>Price: High to Low</option>
                        <option class="bg-black text-white" value="a-z" <%=sortOption==='a-z' ? 'selected' : "" %>>Alphabetical (A-Z)</option>
                        <option class="bg-black text-white" value="z-a" <%=sortOption==='z-a' ? 'selected' : "" %>>Alphabetical (Z-A)</option>
                        <option class="bg-black text-white" value="discount" <%=sortOption==='discount' ? 'selected' : "" %>>Discount</option>
                    </select>
                    <div class="absolute inset-y-0 right-0 flex items-center px-3 pointer-events-none text-white/50">
                        <i class="fas fa-chevron-down text-[10px]"></i>
                    </div>
                </div>
            </div>
        </div>

      <!-- Product cards -->
      <section class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8 mb-16">
        <% if (product && product.length > 0) { %>
          <% product.forEach(products=> { %>
            <article class="group relative rounded-2xl overflow-hidden shadow-2xl aspect-[3/4] cursor-pointer transform hover:-translate-y-2 transition-transform duration-500">
              <a href="/product/<%= products._id %>" class="block w-full h-full">
                <img src="<%= products.image[1] || products.image[0] %>" alt="<%= products.name %>" class="w-full h-full object-cover transform scale-100 group-hover:scale-110 transition-transform duration-700 ease-in-out" />
                
                <!-- Discount Badge -->
                <% if(products.discountedPrice < products.price) { %>
                  <div class="absolute top-4 left-4 bg-gradient-to-r from-red-600 to-orange-500 text-white text-xs font-bold px-3 py-1.5 rounded-full shadow-lg z-10">
                    <%= Math.round(((products.price - products.discountedPrice) / products.price) * 100) %>% OFF
                  </div>
                <% } %>

                <!-- Dark Overlay for text readability -->
                <div class="absolute inset-0 bg-gradient-to-t from-[#050505] via-black/60 to-transparent opacity-90 transition-opacity duration-300"></div>
                
                <!-- Content overlay at bottom -->
                <div class="absolute inset-0 flex flex-col justify-end p-6 z-10">
                  <span class="text-orange-500 text-xs font-bold uppercase tracking-wider mb-1 drop-shadow-md"><%= products.category.name %></span>
                  <h3 class="text-xl font-bold text-white mb-2 line-clamp-2 almendra-sc-regular drop-shadow-md"><%= products.name %></h3>
                  
                  <div class="flex items-center justify-between mt-2 transform translate-y-2 group-hover:translate-y-0 transition-transform duration-300">
                    <div class="flex flex-col">
                      <% if(products.discountedPrice < products.price) { %>
                        <span class="text-2xl text-white font-bold drop-shadow-md">₹<%= products.discountedPrice.toFixed(0) %></span>
                        <span class="text-sm text-gray-300 line-through drop-shadow-md">₹<%= products.price %></span>
                      <% } else { %>
                        <span class="text-2xl text-white font-bold drop-shadow-md">₹<%= products.price %></span>
                      <% } %>
                    </div>
                  </div>
                </div>
              </a>

              <!-- Quick Actions Overlay -->
              <div class="absolute top-4 right-4 flex flex-col gap-3 opacity-100 md:opacity-0 group-hover:opacity-100 transform translate-x-0 md:translate-x-4 group-hover:translate-x-0 transition-all duration-300 z-20">
                <% if(user) { %>
                  <form action="/wishlist/<%= products._id %>" method="POST" class="wishlist-form m-0">
                    <button type="submit" class="wishlist-button w-10 h-10 rounded-full bg-black/40 backdrop-blur-md hover:bg-orange-500 text-white flex items-center justify-center transition-all shadow-lg border border-white/20" data-product-id="<%= products._id %>" data-in-wishlist="<%=products.Wishlist %>">
                      <i class="fas fa-heart <%= products.Wishlist ? 'text-red-500' : '' %>"></i>
                    </button>
                  </form>
                  <button onclick="addToCart('<%= products._id %>')" class="w-10 h-10 rounded-full bg-black/40 backdrop-blur-md hover:bg-orange-500 text-white flex items-center justify-center transition-all shadow-lg border border-white/20">
                    <i class="fas fa-cart-plus"></i>
                  </button>
                <% } else { %>
                  <a href="/login" class="w-10 h-10 rounded-full bg-black/40 backdrop-blur-md hover:bg-orange-500 text-white flex items-center justify-center transition-all shadow-lg border border-white/20">
                    <i class="fas fa-heart"></i>
                  </a>
                  <a href="/login" class="w-10 h-10 rounded-full bg-black/40 backdrop-blur-md hover:bg-orange-500 text-white flex items-center justify-center transition-all shadow-lg border border-white/20">
                    <i class="fas fa-cart-plus"></i>
                  </a>
                <% } %>
              </div>
            </article>
          <% }) %>
        <% } else { %>
          <div class="col-span-full flex justify-center py-20">
             <div class="bg-white/5 border border-white/10 rounded-xl p-8 text-center max-w-md w-full">
               <i class="fas fa-box-open text-4xl text-gray-500 mb-4"></i>
               <p class="text-gray-400">No products available in this category.</p>
             </div>
          </div>
        <% } %>
      </section>

      <!-- Pagination -->
      <% if (totalPages > 1) { %>
      <div class="flex justify-center items-center gap-2 mt-12 mb-8">
        <% for(let i=1;i<=totalPages;i++){ %>
          <a href="?page=<%= i %>&sort=<%= sortOption %>"
            class="w-10 h-10 flex items-center justify-center text-xs font-bold transition-all <%= currentPage === i ? 'bg-white text-black' : 'text-white/50 border border-white/10 hover:bg-white/10 hover:text-white' %> rounded-sm">
            <%= i %>
          </a>
        <% } %>
      </div>
      <% } %>
    </div>


    <%- include ('../partials/footer.ejs')%>

</div>
<script>

  function sortProducts() {
    const sortOption = document.getElementById('sort').value;
    const currentUrl = new URL(window.location.href);
    currentUrl.searchParams.set('sort', sortOption);
    window.location.href = currentUrl.href;
  }

</script>