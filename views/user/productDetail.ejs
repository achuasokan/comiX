<!-- Main container/body -->
<div class="bg-black text-white min-h-screen flex flex-col font-sans">
  <!-- Header -->
  <%- include ('../partials/header.ejs') %>

  <!-- Cinematic Hero Section -->
  <div class="relative w-full min-h-[80vh] flex items-center pt-24 pb-16 overflow-hidden">
    <!-- Blurred Background Image -->
    <div class="absolute inset-0 z-0">
      <img src="<%= product.image[1] || product.image[0] %>" alt="" class="w-full h-full object-cover blur-xl opacity-40 scale-105">
      <div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-transparent"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-black/90 via-black/20 to-black/90"></div>
    </div>

    <div class="container mx-auto px-6 lg:px-12 relative z-10 w-full max-w-7xl">
      <!-- Breadcrumbs (Cinematic Style) -->
      <nav class="text-white/60 py-4 text-xs tracking-widest uppercase mb-8">
        <ol class="list-reset flex items-center gap-3">
          <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
          <li><span class="w-1 h-1 rounded-full bg-white/30 inline-block"></span></li>
          <li><a href="/shop/category/<%= product.category._id %>" class="hover:text-white transition-colors"><%= product.category.name %></a></li>
          <li><span class="w-1 h-1 rounded-full bg-white/30 inline-block"></span></li>
          <li class="font-bold text-white"><%= product.name %></li>
        </ol>
      </nav>

      <div class="flex flex-col lg:flex-row gap-12 lg:gap-20 items-center lg:items-start">
        
        <!-- Left: Crisp Product Image -->
        <div class="w-full max-w-md lg:w-1/3 shrink-0 flex flex-col gap-6">
          <div class="main-image relative w-full aspect-[2/3] rounded-sm overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.5)] border border-white/20 group cursor-crosshair transform transition-transform hover:-translate-y-2 duration-500">
            <img src="<%= product.image[1] || product.image[0] %>" alt="<%= product.name %>"
                 class="w-full h-full object-cover transition-transform duration-300"
                 id="mainImage">
                 
            <% if (product.discountedPrice < product.price) { %>
              <div class="absolute top-4 left-4 bg-white text-black font-bold px-3 py-1 text-sm tracking-wider uppercase shadow-lg z-10">
                <%= Math.round(((product.price - product.discountedPrice) / product.price) * 100) %>% OFF
              </div>
            <% } %>
          </div>

          <!-- Thumbnails -->
          <div class="flex gap-3 justify-center overflow-x-auto custom-scrollbar pb-2">
            <% product.image.forEach((image, index) => { %>
              <div class="relative w-16 h-24 shrink-0 rounded-sm overflow-hidden border border-white/20 hover:border-white cursor-pointer opacity-60 hover:opacity-100 transition-all duration-300 thumb-ring"
                   onclick="changeImage('<%= image %>'); document.querySelectorAll('.thumb-ring').forEach(el => el.classList.remove('border-white', 'opacity-100')); this.classList.add('border-white', 'opacity-100');">
                <img src="<%= image %>" alt="Thumbnail <%= index + 1 %>" class="w-full h-full object-cover">
              </div>
            <% }) %>
          </div>
        </div>

        <!-- Right: Product Info -->
        <div class="w-full lg:w-2/3 flex flex-col justify-center pt-4 lg:pt-10">
          <h1 class="text-5xl md:text-6xl font-bold mb-4 almendra-sc-regular leading-tight drop-shadow-xl text-white"><%= product.name %></h1>
          
          <div class="flex items-center gap-6 mb-8 text-sm tracking-wider uppercase text-white/70">
            <span>SKU: <span class="text-white font-medium"><%= product.SKU %></span></span>
            <span class="w-1 h-1 rounded-full bg-white/30 inline-block"></span>
            <div class="flex items-center gap-2">
              <div class="flex text-yellow-500 text-xs">
                <% for (let i = 0; i < 5; i++) { %>
                  <i class="fas fa-star <%= i < Math.round(product.rating) ? 'text-yellow-500' : 'text-white/20' %>"></i>
                <% } %>
              </div>
              <span><%= product.rating.toFixed(1) %> (<%= product.reviews.length %> Reviews)</span>
            </div>
          </div>

          <div class="mb-10">
            <% if (product.discountedPrice < product.price) { %>
              <div class="flex items-baseline gap-4">
                <span class="text-5xl font-light text-white tracking-tight">₹<%= product.discountedPrice.toFixed(0) %></span>
                <span class="text-2xl text-white/40 line-through">₹<%= product.price %></span>
              </div>
            <% } else { %>
              <span class="text-5xl font-light text-white tracking-tight">₹<%= product.price %></span>
            <% } %>
            
            <% if (product.stock > 0) { %>
              <p class="text-green-400 text-sm tracking-wide mt-3 flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-green-400"></span> In Stock (<%= product.stock %> available)</p>
            <% } else { %>
              <p class="text-red-500 text-sm tracking-wide mt-3 flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-red-500"></span> Out of Stock</p>
            <% } %>
          </div>

          <div class="max-w-2xl text-white/80 leading-relaxed mb-12 text-lg font-light">
            <p><%= product.description %></p>
          </div>

          <!-- Actions -->
          <div class="flex flex-col gap-6">
            <% if (product.stock > 0) { %>
              <div class="flex flex-wrap items-stretch gap-4">
                <!-- Quantity -->
                <div class="flex items-center border border-white/30 bg-black/40 backdrop-blur-md rounded-none w-32 h-14">
                  <button type="button" onclick="if(document.getElementById('quantity').value > 1) document.getElementById('quantity').value--" class="w-10 text-white/70 hover:text-white h-full flex items-center justify-center transition-colors"><i class="fas fa-minus text-xs"></i></button>
                  <input type="number" id="quantity" name="quantity" min="1" max="<%= product.stock < 5 ? product.stock : 5 %>" value="1" class="w-full h-full bg-transparent text-white text-center font-bold text-lg focus:outline-none appearance-none" readonly>
                  <button type="button" onclick="if(parseInt(document.getElementById('quantity').value) < parseInt(document.getElementById('quantity').max)) document.getElementById('quantity').value++" class="w-10 text-white/70 hover:text-white h-full flex items-center justify-center transition-colors"><i class="fas fa-plus text-xs"></i></button>
                </div>

                <!-- Buttons -->
                <% if (user) { %>
                  <button onclick="addToCart('<%= product._id %>', document.getElementById('quantity').value)" class="flex-1 max-w-[200px] border border-white text-white bg-white/5 backdrop-blur-md px-8 h-14 uppercase tracking-widest text-sm font-bold hover:bg-white hover:text-black transition-all duration-300 flex items-center justify-center gap-3">
                    Add to Cart
                  </button>
                  <button class="flex-1 max-w-[200px] bg-white text-black px-8 h-14 uppercase tracking-widest text-sm font-bold hover:bg-gray-200 transition-all duration-300 flex items-center justify-center gap-3 shadow-[0_0_20px_rgba(255,255,255,0.3)]">
                    Buy Now
                  </button>
                <% } else { %>
                  <a href="/login" class="flex-1 max-w-[200px] border border-white text-white bg-white/5 backdrop-blur-md px-8 h-14 flex items-center justify-center uppercase tracking-widest text-sm font-bold hover:bg-white hover:text-black transition-all duration-300 text-center">
                    Add to Cart
                  </a>
                  <a href="/login" class="flex-1 max-w-[200px] bg-white text-black px-8 h-14 flex items-center justify-center uppercase tracking-widest text-sm font-bold hover:bg-gray-200 transition-all duration-300 shadow-[0_0_20px_rgba(255,255,255,0.3)] text-center">
                    Buy Now
                  </a>
                <% } %>
              </div>
            <% } else { %>
              <div class="flex flex-wrap gap-4">
                <button class="border border-white/20 text-white/30 px-12 h-14 uppercase tracking-widest text-sm font-bold cursor-not-allowed" disabled>Sold Out</button>
              </div>
            <% } %>
          </div>

        </div>
      </div>
    </div>
  </div>

  <!-- Content Below Fold: Reviews & Related -->
  <div class="container mx-auto px-6 lg:px-12 py-20 max-w-7xl flex-grow">
    
    <!-- Reviews Section -->
    <div class="mb-20 max-w-4xl mx-auto">
      <div class="flex items-center justify-between mb-8 pb-4 border-b border-white/10">
        <h2 class="text-2xl font-bold almendra-sc-regular text-white">Reader Reviews</h2>
        <span class="text-white/50 text-xs uppercase tracking-widest"><%= product.reviews.length %> Comments</span>
      </div>
      
      <!-- Reviews List -->
      <div class="space-y-4 mb-8 max-h-[400px] overflow-y-auto custom-scrollbar pr-4">
        <% if (product.reviews.length > 0) { %>
          <% product.reviews.forEach(review => { %>
            <div class="flex gap-4 p-4 bg-transparent border-b border-white/5">
              <div class="w-10 h-10 rounded-full border border-white/20 flex items-center justify-center text-white text-sm font-bold shrink-0 bg-white/5">
                <%= (review.userId && review.userId.name) ? review.userId.name.charAt(0).toUpperCase() : 'A' %>
              </div>
              <div class="flex-1">
                <div class="flex items-center gap-3 mb-1">
                  <p class="font-bold text-white text-sm uppercase tracking-wider"><%= (review.userId && review.userId.name) ? review.userId.name : 'Anonymous' %></p>
                  <div class="flex text-yellow-500 text-[10px]">
                    <% for (let i = 0; i < 5; i++) { %>
                      <i class="fas fa-star <%= i < review.rating ? 'text-yellow-500' : 'text-white/20' %>"></i>
                    <% } %>
                  </div>
                </div>
                <p class="text-white/70 text-sm leading-relaxed font-light">"<%= review.comment %>"</p>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="text-center py-8 border border-dashed border-white/10 rounded-sm bg-white/5">
            <p class="text-white/50 text-xs tracking-widest uppercase">No reviews yet.</p>
          </div>
        <% } %>
      </div>

      <!-- Compact Review Input -->
      <% if (user) { %>
        <form action="/product/<%= product._id %>/review" method="POST" class="flex flex-col sm:flex-row gap-4 items-center bg-transparent border-t border-white/10 pt-6">
          <div class="w-full sm:w-auto shrink-0">
            <select id="rating" name="rating" class="w-full sm:w-32 bg-white/5 border border-white/20 text-white text-sm rounded-none p-3 focus:outline-none focus:border-white transition-colors cursor-pointer">
              <option value="5" class="bg-black text-white">5 Stars</option>
              <option value="4" class="bg-black text-white">4 Stars</option>
              <option value="3" class="bg-black text-white">3 Stars</option>
              <option value="2" class="bg-black text-white">2 Stars</option>
              <option value="1" class="bg-black text-white">1 Star</option>
            </select>
          </div>
          <div class="w-full flex-1">
            <input type="text" id="comment" name="comment" class="w-full bg-transparent border-b border-white/20 text-white text-sm p-3 focus:outline-none focus:border-white transition-colors placeholder-white/30" placeholder="Add a comment..." required autocomplete="off">
          </div>
          <div class="w-full sm:w-auto shrink-0">
            <button type="submit" class="w-full sm:w-auto bg-white text-black px-8 py-3 uppercase tracking-widest text-xs font-bold hover:bg-gray-200 transition-colors">
              Post
            </button>
          </div>
        </form>
      <% } else { %>
         <div class="text-center bg-transparent border-t border-white/10 pt-6 flex items-center justify-between">
            <p class="text-white/50 text-xs uppercase tracking-widest">Log in to leave a review</p>
            <a href="/login" class="inline-block border border-white text-white px-6 py-2 uppercase tracking-widest text-xs hover:bg-white hover:text-black transition-colors">Login</a>
         </div>
      <% } %>
    </div>

    <!-- Related Products -->
    <div class="mt-20">
      <div class="mb-10 border-b border-white/10 pb-6 text-center">
        <h2 class="text-3xl font-bold almendra-sc-regular text-white">More Like This</h2>
      </div>
      
      <section class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8">
        <% relatedProducts.forEach(products => { %>
          <article class="group relative rounded-2xl overflow-hidden shadow-2xl aspect-[3/4] cursor-pointer transform hover:-translate-y-2 transition-transform duration-500">
            <a href="/product/<%= products._id %>" class="block w-full h-full">
              <img src="<%= products.image[1] || products.image[0] %>" alt="<%= products.name %>" class="w-full h-full object-cover transform scale-100 group-hover:scale-110 transition-transform duration-700 ease-in-out" />
              
              <!-- Discount Badge -->
              <% if(products.discountedPrice < products.price) { %>
                <div class="absolute top-4 left-4 bg-gradient-to-r from-red-600 to-orange-500 text-white text-xs font-bold px-3 py-1.5 rounded-full shadow-lg z-10">
                  <%= Math.round(((products.price - products.discountedPrice) / products.price) * 100) %>% OFF
                </div>
              <% } %>

              <!-- Dark Overlay for text readability -->
              <div class="absolute inset-0 bg-gradient-to-t from-[#050505] via-black/60 to-transparent opacity-90 transition-opacity duration-300"></div>
              
              <!-- Content overlay at bottom -->
              <div class="absolute inset-0 flex flex-col justify-end p-6 z-10">
                <span class="text-orange-500 text-xs font-bold uppercase tracking-wider mb-1 drop-shadow-md"><%= products.category.name %></span>
                <h3 class="text-xl font-bold text-white mb-2 line-clamp-2 almendra-sc-regular drop-shadow-md"><%= products.name %></h3>
                
                <div class="flex items-center justify-between mt-2 transform translate-y-2 group-hover:translate-y-0 transition-transform duration-300">
                  <div class="flex flex-col">
                    <% if(products.discountedPrice < products.price) { %>
                      <span class="text-2xl text-white font-bold drop-shadow-md">₹<%= products.discountedPrice.toFixed(0) %></span>
                      <span class="text-sm text-gray-300 line-through drop-shadow-md">₹<%= products.price %></span>
                    <% } else { %>
                      <span class="text-2xl text-white font-bold drop-shadow-md">₹<%= products.price %></span>
                    <% } %>
                  </div>
                </div>
              </div>
            </a>

            <!-- Quick Actions Overlay -->
            <div class="absolute top-4 right-4 flex flex-col gap-3 opacity-100 md:opacity-0 group-hover:opacity-100 transform translate-x-0 md:translate-x-4 group-hover:translate-x-0 transition-all duration-300 z-20">
              <% if(user) { %>
                <form action="/wishlist/<%= products._id %>" method="POST" class="wishlist-form m-0">
                  <button type="submit" class="wishlist-button w-10 h-10 rounded-full bg-black/40 backdrop-blur-md hover:bg-orange-500 text-white flex items-center justify-center transition-all shadow-lg border border-white/20" data-product-id="<%= products._id %>" data-in-wishlist="<%=products.Wishlist %>">
                    <i class="fas fa-heart <%= products.Wishlist ? 'text-red-500' : '' %>"></i>
                  </button>
                </form>
                <button onclick="addToCart('<%= products._id %>')" class="w-10 h-10 rounded-full bg-black/40 backdrop-blur-md hover:bg-orange-500 text-white flex items-center justify-center transition-all shadow-lg border border-white/20">
                  <i class="fas fa-cart-plus"></i>
                </button>
              <% } else { %>
                <a href="/login" class="w-10 h-10 rounded-full bg-black/40 backdrop-blur-md hover:bg-orange-500 text-white flex items-center justify-center transition-all shadow-lg border border-white/20">
                  <i class="fas fa-heart"></i>
                </a>
                <a href="/login" class="w-10 h-10 rounded-full bg-black/40 backdrop-blur-md hover:bg-orange-500 text-white flex items-center justify-center transition-all shadow-lg border border-white/20">
                  <i class="fas fa-cart-plus"></i>
                </a>
              <% } %>
            </div>
          </article>
        <% }) %>
      </section>
    </div>
  </div>

  <!-- Footer -->
  <%- include ('../partials/footer.ejs') %>
</div>

<style>
  /* Hide number input arrows */
  input[type=number]::-webkit-inner-spin-button, 
  input[type=number]::-webkit-outer-spin-button { 
    -webkit-appearance: none; 
    margin: 0; 
  }
  input[type=number] {
    -moz-appearance: textfield;
  }
  
  /* Custom thin scrollbar */
  .custom-scrollbar::-webkit-scrollbar {
    height: 4px;
    width: 4px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.2);
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.5); 
  }
</style>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
$(document).ready(function() {
    const imageContainer = $('.main-image'); 
    const productImg = $('#mainImage'); 

    imageContainer.on("mousemove", (e) => {
        const rect = imageContainer[0].getBoundingClientRect(); 
        const x = (e.clientX - rect.left) / rect.width; 
        const y = (e.clientY - rect.top) / rect.height; 
        productImg.css({
            'transform-origin': `${x * 100}% ${y * 100}%`, 
            'transform': 'scale(1.8)' 
        });
    });

    imageContainer.on("mouseleave", () => {
        productImg.css({
            'transform-origin': 'center', 
            'transform': 'scale(1)' 
        });
    });
});

function changeImage(src) {
    const mainImage = $('#mainImage');
    mainImage.attr('src', src);
}
</script>