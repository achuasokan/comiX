<div class="bg-black text-white min-h-screen flex flex-col">
  <%- include('../partials/header.ejs') %>
  
  <div class="flex-grow flex items-center justify-center p-4">
    <div class="text-center max-w-lg mx-auto bg-white/5 border border-white/10 p-12 relative overflow-hidden">
      <!-- subtle green glow in background -->
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-64 h-64 bg-green-500/10 blur-[80px] rounded-full pointer-events-none"></div>
      
      <div class="relative z-10">
        <div class="w-20 h-20 mx-auto rounded-full border border-green-500/30 flex items-center justify-center text-green-400 text-3xl bg-green-500/10 mb-8">
            <i class="fas fa-check"></i>
        </div>
        
        <h1 class="text-3xl font-bold uppercase tracking-widest text-white mb-4">Order Confirmed</h1>
        <p class="text-sm tracking-widest uppercase text-white/50 mb-2">Payment successful</p>
        <p class="text-[10px] tracking-widest uppercase text-white/30 mb-8">Your order has been successfully placed.</p>
        
        <div class="bg-black/50 border border-white/10 p-4 mb-10">
          <p class="text-[10px] uppercase tracking-widest text-white/50 mb-1">Order Number</p>
          <p class="text-lg font-mono text-white">#<%= order._id %></p>
        </div>
        
        <div class="flex flex-col sm:flex-row justify-center space-y-4 sm:space-y-0 sm:space-x-4">
          <a href="/profile/orders" class="bg-transparent border border-white/20 text-white py-4 px-8 text-xs uppercase tracking-widest font-bold hover:bg-white/10 transition-colors">My Orders</a>
          <a href="/" class="bg-white text-black border border-white py-4 px-8 text-xs uppercase tracking-widest font-bold hover:bg-gray-200 transition-colors">Continue Shopping</a>
        </div>
      </div>
    </div>
  </div>

  <%- include('../partials/footer.ejs') %>
</div>