<%- include("../partials/header.ejs") %>

<div class="min-h-screen bg-black flex text-white relative">
  <!-- Left Side: Brand/Graphic -->
  <div class="hidden lg:flex lg:w-1/2 relative overflow-hidden bg-[#050505] border-r border-white/10 items-center justify-center p-12">
    <!-- Abstract background elements -->
    <div class="absolute inset-0 z-0">
      <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-red-600/20 blur-[120px] rounded-full mix-blend-screen"></div>
      <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-yellow-500/10 blur-[120px] rounded-full mix-blend-screen"></div>
      <!-- Grid pattern overlay -->
      <div class="absolute inset-0" style="background-image: radial-gradient(circle at 2px 2px, rgba(255,255,255,0.15) 1px, transparent 0); background-size: 32px 32px;"></div>
    </div>
    
    <div class="relative z-10 max-w-lg">
      <h1 class="text-6xl font-bold uppercase tracking-tighter mb-6 leading-tight">Enter<br>The<br>ComiX.</h1>
      <p class="text-white/50 text-sm tracking-widest uppercase leading-loose border-l-2 border-orange-500 pl-6">
        Unlock your personal vault of comic treasures. Access exclusive drops, manage your orders, and join the community.
      </p>
    </div>
  </div>

  <!-- Right Side: Login Form -->
  <div class="w-full lg:w-1/2 flex items-center justify-center p-8 sm:p-12 md:p-24 relative">
    <div class="w-full max-w-md relative z-10">
      
      <div class="mb-12">
        <h2 class="text-3xl font-bold uppercase tracking-widest mb-2">Welcome Back</h2>
        <p class="text-[10px] tracking-widest uppercase text-white/50">Please enter your details to sign in.</p>
      </div>
      
      <%- include('../partials/flashMessage.ejs') %>
      
      <form class="space-y-8" action="/login" method="POST" id="loginform">
        
        <div class="group">
          <label for="email" class="block mb-2 text-[10px] uppercase tracking-widest font-bold text-white/50 group-focus-within:text-white transition-colors">Email Address</label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 flex items-center pl-4 pointer-events-none">
              <i class="fas fa-envelope text-white/30 group-focus-within:text-white transition-colors"></i>
            </div>
            <input id="email" name="email" type="email" class="w-full bg-white/5 border border-white/10 text-white text-sm py-4 pl-12 pr-4 focus:outline-none focus:border-white focus:bg-white/10 transition-all rounded-sm placeholder-white/20" required placeholder="name@example.com">
          </div>
          <p id="emailError" class="text-red-400 text-[10px] mt-2" aria-live="assertive"></p>
        </div>

        <div class="group">
          <label for="password" class="block mb-2 text-[10px] uppercase tracking-widest font-bold text-white/50 group-focus-within:text-white transition-colors">Password</label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 flex items-center pl-4 pointer-events-none">
              <i class="fas fa-lock text-white/30 group-focus-within:text-white transition-colors"></i>
            </div>
            <input id="password" name="password" type="password" class="w-full bg-white/5 border border-white/10 text-white text-sm py-4 pl-12 pr-12 focus:outline-none focus:border-white focus:bg-white/10 transition-all rounded-sm placeholder-white/20" required placeholder="Enter your password">
            <button type="button" id="togglePassword" class="absolute inset-y-0 right-0 flex items-center pr-4 text-white/30 hover:text-white transition-colors">
              <i class="fas fa-eye" id="eyeIcon"></i>
            </button>
          </div>
          <p id="passwordError" class="text-red-400 text-[10px] mt-2" aria-live="assertive"></p>
        </div>

        <div class="flex items-center justify-between mt-4">
          <div class="flex items-center">
            <input id="remember" type="checkbox" class="w-4 h-4 bg-transparent border border-white/30 rounded-sm focus:ring-white focus:ring-offset-black checked:bg-white checked:border-white accent-white cursor-pointer">
            <label for="remember" class="ml-2 text-[10px] tracking-widest uppercase text-white/50 cursor-pointer">Remember me</label>
          </div>
          <a href="/password/forgot" class="text-[10px] uppercase tracking-widest text-white/50 hover:text-white transition-colors border-b border-transparent hover:border-white pb-0.5">Forgot password?</a>
        </div>

        <div class="pt-4">
          <button type="submit" class="w-full bg-white text-black py-4 uppercase tracking-widest text-xs font-bold hover:bg-gray-200 transition-colors shadow-[0_0_20px_rgba(255,255,255,0.1)] hover:shadow-[0_0_30px_rgba(255,255,255,0.2)]">Sign In</button>
        </div>
      </form>

      <div class="mt-10">
        <div class="relative flex items-center mb-8">
          <div class="flex-grow border-t border-white/10"></div>
          <span class="mx-4 text-[10px] uppercase tracking-widest text-white/30 bg-black px-2">Or continue with</span>
          <div class="flex-grow border-t border-white/10"></div>
        </div>
        
        <a href="/auth/google" aria-label="Sign in with Google" class="w-full flex items-center justify-center gap-3 bg-white/5 border border-white/10 py-4 hover:bg-white/10 transition-colors rounded-sm group">
          <svg class="w-4 h-4 opacity-70 group-hover:opacity-100 transition-opacity" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M21.8055 10.0415H21V10H12V14H17.6515C16.827 16.3285 14.6115 18 12 18C8.6865 18 6 15.3135 6 12C6 8.6865 8.6865 6 12 6C13.5295 6 14.921 6.577 15.9805 7.5195L18.809 4.691C17.023 3.0265 14.634 2 12 2C6.4775 2 2 6.4775 2 12C2 17.5225 6.4775 22 12 22C17.5225 22 22 17.5225 22 12C22 11.3295 21.931 10.675 21.8055 10.0415Z" fill="#FFC107"/>
            <path d="M3.15295 7.3455L6.43845 9.755C7.32745 7.554 9.48045 6 12 6C13.5295 6 14.921 6.577 15.9805 7.5195L18.809 4.691C17.023 3.0265 14.634 2 12 2C8.15895 2 4.82795 4.1685 3.15295 7.3455Z" fill="#FF3D00"/>
            <path d="M12 22C14.583 22 16.93 21.0115 18.7045 19.404L15.6095 16.785C14.5718 17.5742 13.3038 18.001 12 18C9.39903 18 7.19053 16.3415 6.35853 14.027L3.09753 16.5395C4.75253 19.778 8.11353 22 12 22Z" fill="#4CAF50"/>
            <path d="M21.8055 10.0415H21V10H12V14H17.6515C17.2571 15.1082 16.5467 16.0766 15.608 16.7855L15.6095 16.7845L18.7045 19.4035C18.4855 19.6025 22 17 22 12C22 11.3295 21.931 10.675 21.8055 10.0415Z" fill="#1976D2"/>
          </svg>
          <span class="text-[10px] uppercase tracking-widest font-bold text-white/50 group-hover:text-white transition-colors">Sign in with Google</span>
        </a>
      </div>

      <div class="mt-12 text-center">
        <p class="text-[10px] text-white/50 tracking-wider uppercase">
          New to ComiX? 
          <a href="/signup" class="font-bold text-white hover:text-gray-300 transition-colors border-b border-white pb-0.5 ml-2">Create an Account</a>
        </p>
      </div>

    </div>
  </div>
</div>

<%- include("../partials/footer.ejs") %>
<script>
  const togglePassword = document.getElementById('togglePassword');
  const passwordInput = document.getElementById('password');
  const eyeIcon = document.getElementById('eyeIcon');

  togglePassword.addEventListener('click', function () {
    const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
    passwordInput.setAttribute('type', type);
    
    // Using FontAwesome classes now instead of Material Icons
    if (type === 'password') {
        eyeIcon.classList.remove('fa-eye-slash');
        eyeIcon.classList.add('fa-eye');
    } else {
        eyeIcon.classList.remove('fa-eye');
        eyeIcon.classList.add('fa-eye-slash');
    }
  });
</script>
